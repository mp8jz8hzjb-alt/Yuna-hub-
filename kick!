-- 안정적인 OrionLib 주소로 교체
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Orion/main/source"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- 5초 타임아웃을 적용하여 무한 대기 방지
local GrabEvents = ReplicatedStorage:WaitForChild("GrabEvents", 5)
local MenuToys = ReplicatedStorage:WaitForChild("MenuToys", 5)

local SpawnToyRemote = MenuToys and MenuToys:WaitForChild("SpawnToyRemoteFunction", 5)
local SetNetworkOwnerRemote = GrabEvents and GrabEvents:WaitForChild("SetNetworkOwner", 5)
local createLineRemote = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")

local isKickEnabled = false
local selectedPlayerText = ""
local maxTeleportDistance = 25

local kickState = { enabled = false }
local targetState = { targetName = nil }
local connections = {}
local isSpawningPallet = false
local running = false

local function getPlayerList()
    local playerNames = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playerNames, player.DisplayName .. " (@" .. player.Name .. ")")
        end
    end
    return playerNames
end

local function getPlayerFromText(playerText)
    if not playerText or playerText == "" then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        local formattedText = player.DisplayName .. " (@" .. player.Name .. ")"
        if formattedText == playerText then return player end
    end
    return nil
end

local Window = OrionLib:MakeWindow({Name = "Yuna script", HidePremium = true, SaveConfig = false})
local Tab1 = Window:MakeTab({Name = "kick", Icon = "rbxassetid://4483345998"})

local TargetDropdown = Tab1:AddDropdown({
    Name = "Target Player",
    Default = "Select Player",
    Options = getPlayerList(),
    Callback = function(selectedText)
        selectedPlayerText = selectedText
        local targetPlayer = getPlayerFromText(selectedText)
        targetState.targetName = targetPlayer and targetPlayer.Name or nil
    end
})

Tab1:AddToggle({
    Name = "Grab kick (BETA)",
    Default = false,
    Callback = function(enabled)
        isKickEnabled = enabled
        kickState.enabled = enabled

        if isKickEnabled then
            task.spawn(function()
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end
                
                local fixedMyPosition = myRoot.Position

                while isKickEnabled do
                    local targetPlayer = getPlayerFromText(selectedPlayerText)
                    local myCharacter = LocalPlayer.Character
                    local myRootPart = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

                    if myRootPart then
                        myRootPart.AssemblyLinearVelocity = Vector3.zero
                    end

                    if targetPlayer and targetPlayer.Character and myRootPart then
                        local targetRootPart = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if targetRootPart then
                            targetRootPart.AssemblyLinearVelocity = Vector3.zero
                            
                            local bodyPosition = targetRootPart:FindFirstChild("ControlBP")
                            if not bodyPosition then
                                bodyPosition = Instance.new("BodyPosition")
                                bodyPosition.Name = "ControlBP"
                                bodyPosition.Parent = targetRootPart
                            end
                            bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bodyPosition.P = 2000000
                            bodyPosition.D = 1250
                            bodyPosition.Position = fixedMyPosition + Vector3.new(0, 30, 0)
                        end
                    end
                    task.wait()
                end

                local targetPlayer = getPlayerFromText(selectedPlayerText)
                if targetPlayer and targetPlayer.Character then
                    local targetRootPart = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if targetRootPart and targetRootPart:FindFirstChild("ControlBP") then
                        targetRootPart.ControlBP:Destroy()
                    end
                end
            end)
        end
    end
})

OrionLib:Init()
